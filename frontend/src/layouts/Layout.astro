---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';


interface Props {
	title: string;
	description?: string;
}

const { title, description = "GC Global Consultores — Asesoramiento Jurídico Profesional y de Vanguardia" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/Logo.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | GC Global Consultores</title>
		<meta name="description" content={description} />
		<script is:inline src="https://unpkg.com/@phosphor-icons/web"></script>
		<script type="application/ld+json" is:inline>
			{
				"@context": "https://schema.org",
				"@type": "LegalService",
				"name": "GC Global Consultores",
				"image": "https://gcglobal.mx/Logo.png",
				"@id": "https://gcglobal.mx/#legalservice",
				"url": "https://gcglobal.mx",
				"telephone": "+524494136546",
				"address": {
					"@type": "PostalAddress",
					"streetAddress": "Av. Alameda 231, Int. 301, Barrio de la Estación",
					"addressLocality": "Aguascalientes",
					"addressRegion": "Ags.",
					"postalCode": "20270",
					"addressCountry": "MX"
				},
				"geo": {
					"@type": "GeoCoordinates",
					"latitude": 21.8804997,
					"longitude": -102.2858978
				},
				"openingHoursSpecification": {
					"@type": "OpeningHoursSpecification",
					"dayOfWeek": [
						"Monday",
						"Tuesday",
						"Wednesday",
						"Thursday",
						"Friday"
					],
					"opens": "09:00",
					"closes": "18:00"
				},
				"sameAs": [
					"https://linkedin.com",
					"https://instagram.com"
				]
			}
		</script>
	</head>
	<body class="bg-bg text-text font-dmsans selection:bg-primary selection:text-white antialiased">
		<div class="noise-bg" aria-hidden="true"></div>

		<Navbar />
		<slot />
		<Footer />
	</body>
</html>
