---
import { HoverButton } from './ui/hover-glow-button';

interface Props {
  text: string;
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  id?: string;
}

const { text, href, variant = 'primary', class: className = '', type = 'button', id } = Astro.props;

// Determine colors based on variants following firm branding
const config = {
  primary: {
    backgroundColor: '#1B365D', // --color-primary
    glowColor: '#B8C5D6', // --color-gold glow (now platinum) makes it stand out beautifully
    textColor: '#F1F5F9', // --color-text
    hoverTextColor: '#B8C5D6', // --color-gold (now platinum)
    customClass: 'border-2 border-transparent shadow-[0_4px_20px_rgba(27,54,93,0.3)] hover:shadow-[0_6px_25px_rgba(27,54,93,0.5)]'
  },
  secondary: {
    backgroundColor: '#F1F5F9', // --color-text
    glowColor: '#1B365D',
    textColor: '#0A0D14', // dark background text
    hoverTextColor: '#1B365D',
    customClass: 'border-2 border-transparent'
  },
  outline: {
    backgroundColor: 'transparent',
    glowColor: '#1B365D',
    textColor: '#F1F5F9',
    hoverTextColor: '#B8C5D6',
    customClass: 'border-2 border-[#1B365D] hover:border-[#B8C5D6] transition-colors duration-300'
  }
};

const currentConfig = config[variant];
---

<HoverButton
  client:visible
  id={id}
  href={href}
  type={type}
  glowColor={currentConfig.glowColor}
  backgroundColor={currentConfig.backgroundColor}
  textColor={currentConfig.textColor}
  hoverTextColor={currentConfig.hoverTextColor}
  className={`${currentConfig.customClass} ${className}`}
>
  {text}
</HoverButton>
