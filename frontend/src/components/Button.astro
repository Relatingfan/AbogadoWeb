---
import { HoverButton } from './ui/hover-glow-button';

interface Props {
  text: string;
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  id?: string;
}

const { text, href, variant = 'primary', class: className = '', type = 'button', id } = Astro.props;

// Determine colors based on variants following GC Global branding
const config = {
  primary: {
    backgroundColor: '#2A6B2A', // --color-primary
    glowColor: '#C9A84C', // --color-gold glow makes it stand out beautifully
    textColor: '#F2EFE9', // --color-text
    hoverTextColor: '#C9A84C', // --color-gold
    customClass: 'border-2 border-transparent shadow-[0_4px_20px_rgba(42,107,42,0.3)] hover:shadow-[0_6px_25px_rgba(42,107,42,0.5)]'
  },
  secondary: {
    backgroundColor: '#F2EFE9', // --color-text
    glowColor: '#2A6B2A',
    textColor: '#0D0D0D', // dark background text
    hoverTextColor: '#2A6B2A',
    customClass: 'border-2 border-transparent'
  },
  outline: {
    backgroundColor: 'transparent',
    glowColor: '#4CAF50', // --color-primary-h
    textColor: '#F2EFE9',
    hoverTextColor: '#C9A84C',
    customClass: 'border-2 border-[#2A6B2A] hover:border-[#C9A84C] transition-colors duration-300'
  }
};

const currentConfig = config[variant];
---

<HoverButton
  client:visible
  id={id}
  href={href}
  glowColor={currentConfig.glowColor}
  backgroundColor={currentConfig.backgroundColor}
  textColor={currentConfig.textColor}
  hoverTextColor={currentConfig.hoverTextColor}
  className={`${currentConfig.customClass} ${className}`}
>
  {text}
</HoverButton>
