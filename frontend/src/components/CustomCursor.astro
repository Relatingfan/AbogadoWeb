<div id="custom-cursor" class="hidden lg:block fixed top-0 left-0 w-6 h-6 rounded-full border border-legal-green pointer-events-none z-[9999] -translate-x-1/2 -translate-y-1/2 transition-transform duration-75 ease-out">
  <div class="w-1.5 h-1.5 bg-legal-light rounded-full absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"></div>
</div>

<script>
  import { gsap } from 'gsap';

  const cursor = document.getElementById('custom-cursor');
  
  if (cursor) {
    const style = document.createElement('style');
    style.innerHTML = `@media (min-width: 1024px) { body, a, button, input, select, textarea, [role="button"] { cursor: none !important; } }`;
    document.head.appendChild(style);

    gsap.set(cursor, { x: window.innerWidth / 2, y: window.innerHeight / 2 });

    window.addEventListener('mousemove', (e) => {
      gsap.to(cursor, { x: e.clientX, y: e.clientY, duration: 0.25, ease: 'power2.out', overwrite: 'auto' });
    });

    const updateHoverTargets = () => {
      const interactiveElements = document.querySelectorAll('a, button, input, select, textarea, [role="button"], .interactive-hover');
      interactiveElements.forEach((el) => {
        el.removeEventListener('mouseenter', onMouseEnter);
        el.removeEventListener('mouseleave', onMouseLeave);
        el.addEventListener('mouseenter', onMouseEnter);
        el.addEventListener('mouseleave', onMouseLeave);
      });
    };

    const onMouseEnter = () => {
      gsap.to(cursor, { scale: 2.2, borderColor: '#4CAF50', backgroundColor: 'rgba(42, 107, 42, 0.15)', duration: 0.3, ease: 'power1.out' });
    };

    const onMouseLeave = () => {
      gsap.to(cursor, { scale: 1, borderColor: '#2A6B2A', backgroundColor: 'transparent', duration: 0.3, ease: 'power1.out' });
    };

    updateHoverTargets();
    const observer = new MutationObserver(updateHoverTargets);
    observer.observe(document.body, { childList: true, subtree: true });
  }
</script>
