---
import Button from '../Button.astro';
---

<section id="contacto" class="py-24 bg-bg relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      
      <!-- Contact Info -->
      <div class="reveal-left">
        <h2 class="font-playfair text-4xl md:text-5xl text-text mb-6">
          Agende su <span class="italic text-primary">consulta</span>
        </h2>
        <p class="font-dmsans font-light text-text/70 text-lg mb-12 max-w-md">
          Nuestro equipo de especialistas está listo para escuchar su caso y brindarle la orientación legal que necesita con absoluta confidencialidad.
        </p>

        <div class="space-y-8 font-dmsans font-light text-text">
          <div class="flex items-start gap-4">
            <i class="ph-light ph-map-pin text-2xl text-primary mt-1"></i>
            <div>
              <p class="font-medium mb-1">Oficina Principal (Sede Aguascalientes)</p>
              <p class="text-text/70 text-sm">Av. Alameda 231, Int. 301,<br/>Barrio de la Estación, Aguascalientes, Ags.</p>
            </div>
          </div>
          

          
          <div class="flex items-start gap-4">
            <i class="ph-light ph-envelope-simple text-2xl text-primary mt-1"></i>
            <div>
              <p class="font-medium mb-1">Correo Electrónico</p>
              <a href="mailto:dgabogados01_@gmail.com" class="text-text/70 hover:text-primary transition-colors">dgabogados01_@gmail.com</a>
            </div>
          </div>
        </div>

        <!-- Google Maps Embed -->
        <div class="mt-12 h-64 w-full border border-white/5 opacity-80 hover:opacity-100 transition-opacity duration-300">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3702.3492665364797!2d-102.28241655845125!3d21.882622352809857!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8429ef036b397657%3A0x248e0cd42517353a!2sGLOBAL%20CONSULTORES%20(ABOGADOS)!5e0!3m2!1ses-419!2smx!4v1779471778434!5m2!1ses-419!2smx"
            width="100%" 
            height="100%" 
            style="border:0; filter: grayscale(1) invert(0.9) contrast(1.2);" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación de GC Global Consultores en Aguascalientes"
          ></iframe>
        </div>
      </div>
      <!-- Contact Form -->
      <div class="bg-bg p-8 md:p-10 border border-primary/20 reveal-right">
        <form id="contactForm" class="space-y-6">
          <div class="space-y-2">
            <label for="name" class="font-josefin text-xs uppercase tracking-wider text-text/70">Nombre Completo *</label>
            <input type="text" id="name" required class="w-full bg-transparent border-b border-white/20 pb-2 text-text focus:outline-none focus:border-primary transition-colors" placeholder="Ej. Juan Pérez" />
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="phone" class="font-josefin text-xs uppercase tracking-wider text-text/70">Teléfono / WhatsApp *</label>
              <input type="tel" id="phone" required class="w-full bg-transparent border-b border-white/20 pb-2 text-text focus:outline-none focus:border-primary transition-colors" placeholder="+52 55..." />
            </div>
            <div class="space-y-2">
              <label for="email" class="font-josefin text-xs uppercase tracking-wider text-text/70">Correo Electrónico *</label>
              <input type="email" id="email" required class="w-full bg-transparent border-b border-white/20 pb-2 text-text focus:outline-none focus:border-primary transition-colors" placeholder="correo@ejemplo.com" />
            </div>
          </div>
 
          <div class="space-y-2">
            <label for="service" class="font-josefin text-xs uppercase tracking-wider text-text/70">Área de Interés</label>
            <select id="service" class="w-full bg-transparent border-b border-white/20 pb-2 text-text focus:outline-none focus:border-primary transition-colors appearance-none cursor-pointer">
              <option value="" class="bg-bg">Seleccione un área...</option>
              <option value="asesoria-juridica" class="bg-bg">Asesoría Jurídica</option>
              <option value="juicios-penales" class="bg-bg">Juicios Penales</option>
              <option value="juicios-civiles" class="bg-bg">Juicios civiles</option>
              <option value="juicios-laborales" class="bg-bg">Juicios Laborales</option>
              <option value="juicios-familiares" class="bg-bg">Juicios Familiares</option>
              <option value="juicios-mercantiles" class="bg-bg">Juicios Mercantiles</option>
              <option value="otro" class="bg-bg">Otro</option>
            </select>
          </div>
 
          <div class="space-y-2">
            <label for="message" class="font-josefin text-xs uppercase tracking-wider text-text/70">Mensaje Breve</label>
            <textarea id="message" rows="3" class="w-full bg-transparent border-b border-white/20 pb-2 text-text focus:outline-none focus:border-primary transition-colors resize-none" placeholder="Describa brevemente su situación..."></textarea>
          </div>
 
          <div class="pt-4">
            <Button variant="primary" class="w-full flex justify-center py-4" id="submitBtn" type="submit" text="Enviar Mensaje" />
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Toast Container para Feedback -->
  <div id="toastContainer" class="fixed bottom-6 right-6 z-50 flex flex-col gap-3 pointer-events-none"></div>
</section>


<script>
  const form = document.getElementById('contactForm');
  const submitBtn = document.getElementById('submitBtn');
  const toastContainer = document.getElementById('toastContainer');

  function showToast(message: string, type: 'success' | 'error') {
    if (!toastContainer) return;
    const toast = document.createElement('div');
    // Se usa CSS nativo (Tailwind) para cumplir con el diseño, mostrando error en rojo y éxito en azul primario
    toast.className = `px-6 py-4 rounded shadow-lg text-sm font-dmsans font-medium text-text pointer-events-auto flex items-center gap-3 transform transition-all duration-300 translate-y-full opacity-0 ${type === 'success' ? 'bg-primary/95 border border-primary' : 'bg-red-600/95 border border-red-500'}`;
    
    const icon = document.createElement('i');
    icon.className = type === 'success' ? 'ph-bold ph-check-circle text-xl' : 'ph-bold ph-warning-circle text-xl';
    
    const text = document.createElement('span');
    text.textContent = message;
    
    toast.appendChild(icon);
    toast.appendChild(text);
    toastContainer.appendChild(toast);
    
    // Animar entrada
    requestAnimationFrame(() => {
      // Un pequeño delay para que la transición funcione al agregar el elemento al DOM
      setTimeout(() => {
        toast.classList.remove('translate-y-full', 'opacity-0');
      }, 10);
    });
    
    // Remover después de 4.5 segundos
    setTimeout(() => {
      toast.classList.add('translate-y-full', 'opacity-0');
      setTimeout(() => toast.remove(), 300); // esperar transición
    }, 4500);
  }

  if(form && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const name = (document.getElementById('name') as HTMLInputElement).value.trim();
      const phone = (document.getElementById('phone') as HTMLInputElement).value.trim();
      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      const serviceSelect = document.getElementById('service') as HTMLSelectElement;
      const serviceText = serviceSelect.value ? serviceSelect.options[serviceSelect.selectedIndex].text : 'General';
      const message = (document.getElementById('message') as HTMLTextAreaElement).value.trim();

      if (!name || !phone || !email) {
        showToast('Por favor, completa los campos obligatorios.', 'error');
        return;
      }

      // Simular botón cargando
      const btnText = submitBtn.querySelector('span') || submitBtn;
      const originalText = btnText.textContent;
      btnText.textContent = 'Enviando...';
      submitBtn.style.opacity = '0.7';
      submitBtn.style.pointerEvents = 'none';
      
      // Construir mensaje de WhatsApp con formato solicitado
      const waText = `Buenas tardes, mi nombre es ${name}, estoy interesado en el area de ${serviceText} y tengo la siguiente situacion ${message || '(Sin descripción extra)'}.`;
      const waNumber = "524494136546"; // 449 413 6546
      const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(waText)}`;
      
      try {
        const newWindow = window.open(waUrl, '_blank');
        if (!newWindow || newWindow.closed || typeof newWindow.closed === 'undefined') {
          // El navegador bloqueó el popup
          showToast('El navegador bloqueó la redirección. Habilita las ventanas emergentes o usa este enlace: ' + waUrl, 'error');
        } else {
          // Se abrió con éxito
          showToast('¡Mensaje preparado! Redirigiendo a WhatsApp...', 'success');
          form.reset();
        }
      } catch(err) {
        showToast('Ocurrió un error al intentar abrir WhatsApp.', 'error');
      }

      // Restaurar botón después de 1 segundo
      setTimeout(() => {
        btnText.textContent = originalText;
        submitBtn.style.opacity = '1';
        submitBtn.style.pointerEvents = 'auto';
      }, 1000);
    });
  }
</script>
