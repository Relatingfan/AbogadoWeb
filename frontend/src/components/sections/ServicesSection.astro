---
import ServiceCard from '../ServiceCard.astro';

const services = [
  {
    title: "Asesoría Jurídica",
    description: "Soluciones legales preventivas y estratégicas. Brindamos orientación personalizada para proteger sus intereses personales y comerciales ante cualquier situación jurídica.",
    icon: "ph-briefcase"
  },
  {
    title: "Juicios Penales",
    description: "Defensa y representación penal de alta especialización. Salvaguardamos su libertad, patrimonio y derechos en procesos penales complejos con un enfoque estratégico y ético.",
    icon: "ph-gavel"
  },
  {
    title: "Juicios civiles",
    description: "Litigio civil integral para la resolución de controversias de propiedad, contratos y obligaciones. Protegemos su patrimonio con el máximo rigor legal y técnico.",
    icon: "ph-scales"
  },
  {
    title: "Juicios Laborales",
    description: "Defensa especializada en conflictos de trabajo. Protegemos las relaciones laborales y empresariales con estrategias de mediación y litigio de alto impacto.",
    icon: "ph-users-three"
  },
  {
    title: "Juicios Familiares",
    description: "Asesoría sensible y profesional en derecho familiar. Acompañamos procesos de divorcio, pensiones, custodias y sucesiones priorizando la estabilidad e integridad de su familia.",
    icon: "ph-house-line"
  },
  {
    title: "Juicios Mercantiles",
    description: "Representación legal en disputas comerciales y de negocios. Resolvemos conflictos societarios, cobranza judicial y controversias contractuales con eficiencia y celeridad.",
    icon: "ph-handshake"
  }
];
---

<section id="servicios" class="py-32 relative bg-transparent z-20">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    <div class="mb-20">
      <div class="flex items-center gap-4 mb-6 reveal-text">
        <div class="w-12 h-px bg-gold"></div>
        <span class="font-josefin text-xs tracking-[0.3em] uppercase text-black">Áreas de Práctica</span>
      </div>
      <h2 class="font-cormorant text-4xl md:text-5xl lg:text-6xl font-light text-black leading-tight reveal-text">
        Especialización que <br class="hidden md:block"/>
        <span class="font-playfair italic text-black">marca el precedente.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 stagger-container">
      {services.map((service, index) => (
        <ServiceCard 
          title={service.title} 
          description={service.description} 
          icon={service.icon} 
          delay={index * 0.05}
        />
      ))}
    </div>
  </div>
</section>
