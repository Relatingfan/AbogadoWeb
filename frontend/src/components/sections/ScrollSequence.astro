---
const frameModules = import.meta.glob('../../../../assets/Scroll/*.webp', { eager: true, query: '?url' });
const keys = Object.keys(frameModules).sort();
const frameUrls = keys.map((key) => {
  const mod = frameModules[key] as any;
  return mod.default || mod;
});
const firstFrameUrl = frameUrls.length > 0 ? frameUrls[0] : '';
---

<div class="fixed top-0 left-0 w-full h-screen pointer-events-none z-0 overflow-hidden">
  <canvas id="hero-canvas" class="hidden lg:block w-full h-full object-cover opacity-40 mix-blend-luminosity scale-105"></canvas>
  {firstFrameUrl && (
    <img id="hero-static" src={firstFrameUrl} class="block lg:hidden w-full h-full object-cover opacity-40 mix-blend-luminosity scale-105" alt="Background" />
  )}
  <div class="absolute inset-0 bg-gradient-to-b from-bg/60 via-transparent to-bg z-10"></div>
</div>

<script define:vars={{ frameUrls }}>
  window.scrollFrameUrls = frameUrls;
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('hero-canvas');
    if (!canvas) return;
    const context = canvas.getContext('2d');
    if (!context) return;
    
    // Check reduced motion or mobile device
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.matchMedia('(max-width: 1023px)').matches;
    
    if (prefersReducedMotion || isMobile) {
      canvas.style.display = 'none';
      return;
    }
    
    let currentFrame = 0;
    const frameCount = window.scrollFrameUrls.length;
    const images = [];
    let loaded = 0;
    
    // Preload all images
    for (let i = 0; i < frameCount; i++) {
      const img = new Image();
      img.onload = () => {
        loaded++;
        if (loaded === 1) render(); // Render first frame ASAP
      };
      img.src = window.scrollFrameUrls[i];
      images.push(img);
    }
    
    // Resize canvas
    const resize = () => {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      render();
    };
    window.addEventListener('resize', resize);
    resize();

    function render() {
      const frameIndex = Math.round(currentFrame);
      if (!images[frameIndex]) return;
      const img = images[frameIndex];
      if (!img.complete || img.naturalWidth === 0) return;
      
      const canvasRatio = canvas.width / canvas.height;
      const imgRatio = img.width / img.height;
      
      let drawWidth, drawHeight, offsetX, offsetY;
      
      if (imgRatio > canvasRatio) {
        drawHeight = canvas.height;
        drawWidth = canvas.height * imgRatio;
        offsetX = (canvas.width - drawWidth) / 2;
        offsetY = 0;
      } else {
        drawWidth = canvas.width;
        drawHeight = canvas.width / imgRatio;
        offsetX = 0;
        offsetY = (canvas.height - drawHeight) / 2;
      }
      
      context.clearRect(0, 0, canvas.width, canvas.height);
      context.drawImage(img, offsetX, offsetY, drawWidth, drawHeight);
    }

    let ticking = false;
    
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          // We want the animation to complete when scrolling 1.5x viewport heights
          // Adjust maxScroll to control animation speed
          const maxScroll = window.innerHeight * 1.5; 
          let progress = scrollY / maxScroll;
          if (progress < 0) progress = 0;
          if (progress > 1) progress = 1;
          
          currentFrame = progress * (frameCount - 1);
          render();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  });
</script>
