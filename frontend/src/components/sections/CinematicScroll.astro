---
import Text3DFlip from '../ui/text-3d-flip';
---

<section class="relative min-h-[60vh] py-20 w-full overflow-hidden flex items-center justify-center">
  <div 
    id="parallax-bg"
    class="absolute inset-0 w-full h-[120%] -top-[10%] bg-[url('https://images.unsplash.com/photo-1505664177275-b1664cb87d15?q=80&w=2000&auto=format&fit=crop')] bg-cover bg-center opacity-30 mix-blend-luminosity"
  ></div>
  <div class="absolute inset-0 bg-gradient-to-b from-bg via-bg/60 to-bg pointer-events-none"></div>
  
  <div class="relative z-20 max-w-4xl mx-auto px-6 text-center reveal-text w-full" style="perspective: 1000px;">
    <i class="ph ph-quotes text-5xl text-gold mb-6 opacity-50 block mx-auto"></i>
    <Text3DFlip
      client:visible
      text="&quot;La justicia no es un ideal distante; es una estrategia ejecutada con precisión.&quot;"
      className="font-outfit font-light text-2xl md:text-4xl lg:text-5xl text-center justify-center leading-snug w-full"
      textClassName="text-text"
      flipTextClassName="text-gold"
      rotateDirection="top"
      staggerDuration={0.03}
      staggerFrom="first"
      transition={{ type: "spring", damping: 25, stiffness: 160 }}
    />
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    let mm = gsap.matchMedia();

    mm.add("(min-width: 1024px)", () => {
      gsap.to('#parallax-bg', {
        yPercent: 20,
        ease: 'none',
        scrollTrigger: {
          trigger: '#parallax-bg',
          start: 'top bottom',
          end: 'bottom top',
          scrub: true
        }
      });
    });
  });
</script>
