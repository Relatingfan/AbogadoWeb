---
import SkewCards from '../ui/gradient-card-showcase.tsx';
---

<section id="nosotros" class="diff-section">
  <div class="diff-container">
    <div class="diff-header reveal-up">
      <h2 class="font-playfair text-4xl md:text-5xl lg:text-6xl text-legal-white mb-6">
        ¿Por qué elegir <span class="text-legal-green italic">GC Global</span>?
      </h2>
      <div class="gold-divider w-24 mx-auto mb-6"></div>
      <p class="font-dmsans font-light text-legal-grey text-lg md:text-xl max-w-3xl mx-auto">
        Nos distinguimos por nuestra dedicación inquebrantable a la excelencia legal, combinando experiencia comprobada con un enfoque moderno y altamente personalizado.
      </p>
    </div>

    <SkewCards client:visible />
  </div>
</section>

<style>
  .diff-section {
    padding: 6rem 0;
    background-color: var(--color-bg-black, #0D0D0D);
    position: relative;
    overflow: hidden;
  }

  .diff-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
    z-index: 1;
  }

  .diff-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .diff-section :global(.group) {
      transition: none;
    }
    .diff-section :global(.animate-blob) {
      animation: none;
    }
  }
</style>
