---
---

<section id="nosotros" class="py-24 bg-bg-black relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    <div class="mb-16 text-center reveal-up">
      <h2 class="font-playfair text-4xl md:text-5xl lg:text-6xl text-legal-white mb-6">
        ¿Por qué elegir <span class="text-legal-green italic">GC Global</span>?
      </h2>
      <div class="gold-divider w-24 mx-auto mb-6"></div>
      <p class="font-dmsans font-light text-legal-grey text-lg md:text-xl max-w-3xl mx-auto">
        Nos distinguimos por nuestra dedicación inquebrantable a la excelencia legal, combinando experiencia comprobada con un enfoque moderno y altamente personalizado.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {
        [
          {
            title: "Trato Exclusivo",
            desc: "Atención personalizada 1 a 1 con socios del despacho en todo momento.",
            icon: "ph ph-star"
          },
          {
            title: "Visión Global",
            desc: "Soluciones legales que consideran el contexto internacional de los negocios.",
            icon: "ph ph-globe"
          },
          {
            title: "Ética Intachable",
            desc: "Transparencia total y honestidad en cada recomendación que hacemos.",
            icon: "ph ph-scales"
          },
          {
            title: "Estrategia de Vanguardia",
            desc: "Uso de herramientas y metodologías innovadoras para resolver casos complejos.",
            icon: "ph ph-compass"
          }
        ].map((item, index) => (
          <div class={`differentiator-card bg-[#111] p-8 border border-white/5 hover:border-legal-green transition-all duration-300 reveal-up hover:-translate-y-2`} style={`transition-delay: ${index * 100}ms`}>
            <i class={`${item.icon} text-4xl text-legal-green mb-6 block`}></i>
            <h3 class="font-playfair text-2xl text-legal-white mb-4">{item.title}</h3>
            <p class="font-dmsans font-light text-legal-grey text-sm md:text-base leading-relaxed">
              {item.desc}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
