---
const testimonials = [
  {
    name: "HAdrián Gallegos",
    meta: "3 weeks ago",
    text: "Excelente servicio yo estoy en Canadá ellos me ayudaron con un tema internacional me entregaron los documentos en inglés y español y todo fue en tiempo y forma a lo...",
    hasReadMore: true,
    stars: 5,
    avatar: "H",
    avatarBg: "bg-[#7A584E]",
    isImage: false
  },
  {
    name: "Ing. Ricardo González",
    meta: "1 month ago",
    text: "Excelente servicio",
    hasReadMore: false,
    stars: 5,
    avatar: "https://randomuser.me/api/portraits/men/32.jpg",
    avatarBg: "",
    isImage: true
  },
  {
    name: "Juanis Gonzalez",
    meta: "1 month ago",
    text: "Muy Buena Licenciada Apesard De Que Todo Fue Por Llamada Fue Muy Rápido El Proceso Me Soluciono Muy Rápido Mi Problema, Es Muy Atenta SUPER RECOMENDA",
    hasReadMore: false,
    stars: 5,
    avatar: "J",
    avatarBg: "bg-[#0F5A47]",
    isImage: false
  },
  {
    name: "Brenda Leyva",
    meta: "2 months ago",
    text: "La atención brindada fue de primer nivel. Respondieron todas mis dudas de manera clara y el seguimiento del trámite fue impecable de principio a fin. Sin duda volveré a confiar en ellos.",
    hasReadMore: false,
    stars: 5,
    avatar: "B",
    avatarBg: "bg-[#1A365D]",
    isImage: false
  }
];
---

<section id="testimonios" class="py-32 bg-bg relative overflow-hidden border-t border-primary/20">
  <!-- Subtle radial background glow -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(10,25,48,0.06)_0%,transparent_70%)] pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    <div class="mb-20 reveal-up">
      <div class="flex items-center gap-4 mb-6">
        <div class="w-12 h-px bg-gold/50"></div>
        <span class="font-josefin text-xs tracking-[0.3em] uppercase text-gold">Testimonios</span>
      </div>
      <h2 class="font-cormorant text-4xl md:text-5xl lg:text-6xl font-light text-text leading-tight">
        Opiniones en <br class="hidden md:block"/>
        <span class="font-playfair italic text-primary">Google Reviews.</span>
      </h2>
    </div>

    <!-- Carousel Container Wrapper -->
    <div class="relative px-4 md:px-8">
      
      <!-- Left Navigation Arrow (Floating Circular Button) -->
      <button 
        id="testimonial-prev" 
        class="absolute left-[-10px] md:left-0 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-[#1e1e1e] hover:bg-[#333333] text-white flex items-center justify-center z-20 cursor-pointer shadow-lg transition-colors duration-300"
        aria-label="Anterior testimonio"
      >
        <i class="ph ph-caret-left text-lg font-bold"></i>
      </button>

      <!-- Cards container -->
      <div 
        id="testimonials-container" 
        class="flex gap-6 overflow-x-auto snap-x snap-mandatory pb-6 cursor-grab active:cursor-grabbing select-none"
        role="region" 
        aria-roledescription="carousel" 
        aria-label="Opiniones de clientes en Google"
      >
        {testimonials.map((t, idx) => (
          <div 
            class="testimonial-card snap-start shrink-0 w-full md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] bg-white border border-primary/20 p-7 flex flex-col justify-between relative min-h-[250px]"
            role="group" 
            aria-roledescription="slide" 
            aria-label={`Opinión ${idx + 1} de ${testimonials.length}`}
          >
            <div>
              <!-- Header Section -->
              <div class="flex items-start justify-between mb-4">
                <div class="flex items-center gap-3.5">
                  <!-- User Avatar (Circle) -->
                  {t.isImage ? (
                    <img 
                      src={t.avatar} 
                      alt={`Foto de ${t.name}`} 
                      class="w-11 h-11 rounded-full object-cover shrink-0 border border-primary/10" 
                    />
                  ) : (
                    <div class={`w-11 h-11 rounded-full flex items-center justify-center text-white font-dmsans text-[17px] font-medium shrink-0 ${t.avatarBg}`}>
                      {t.avatar}
                    </div>
                  )}
                  
                  <div>
                    <h4 class="font-dmsans text-[15px] font-bold text-text leading-tight">{t.name}</h4>
                    <p class="font-dmsans text-[12px] text-text/60 mt-1">{t.meta}</p>
                  </div>
                </div>

                <!-- Colored Google Logo SVG -->
                <div class="shrink-0 mt-1">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                  </svg>
                </div>
              </div>

              <!-- Star Rating & Blue Verification Badge -->
              <div class="flex items-center gap-1 mb-4">
                <div class="flex gap-0.5" aria-label={`Calificación ${t.stars} de 5 estrellas`}>
                  {Array.from({ length: t.stars }).map(() => (
                    <i class="ph-fill ph-star text-[#F4B400] text-[17px]"></i>
                  ))}
                </div>
                <!-- Google Blue Verification Check Circle -->
                <span class="inline-flex items-center justify-center bg-[#2f7bf6] rounded-full p-0.5 w-3.5 h-3.5 ml-1">
                  <svg class="w-2.5 h-2.5 text-white stroke-[3.5px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                  </svg>
                </span>
              </div>
              
              <!-- Review Text content -->
              <p class="font-dmsans text-[14px] leading-relaxed text-text/80 font-light">
                {t.text}
              </p>

              <!-- Optional Read More Link -->
              {t.hasReadMore && (
                <button class="font-dmsans text-[13px] text-text/60 mt-1 block hover:underline cursor-pointer text-left hover:text-primary">
                  Read more
                </button>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Right Navigation Arrow (Floating Circular Button) -->
      <button 
        id="testimonial-next" 
        class="absolute right-[-10px] md:right-0 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-[#1e1e1e] hover:bg-[#333333] text-white flex items-center justify-center z-20 cursor-pointer shadow-lg transition-colors duration-300"
        aria-label="Siguiente testimonio"
      >
        <i class="ph ph-caret-right text-lg font-bold"></i>
      </button>


      
    </div>
  </div>
</section>

<style>
  #testimonials-container {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
    scroll-behavior: smooth;
  }
  #testimonials-container::-webkit-scrollbar {
    display: none;  /* Chrome, Safari and Opera */
  }

  .testimonial-card {
    transition: 
      border-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonial-card {
      transition: none !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('testimonials-container');
    const prevBtn = document.getElementById('testimonial-prev');
    const nextBtn = document.getElementById('testimonial-next');
    const dots = document.querySelectorAll('.testimonial-dot');
    
    if (!container || !prevBtn || !nextBtn) return;

    const getScrollBehavior = () => {
      const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      return mediaQuery.matches ? 'auto' : 'smooth';
    };

    const getCardWidth = () => {
      const firstCard = container.firstElementChild;
      if (!firstCard) return 0;
      const style = window.getComputedStyle(firstCard);
      const marginRight = parseFloat(style.marginRight) || 0;
      return firstCard.getBoundingClientRect().width + marginRight || 24;
    };

    const updateDots = (activeIndex) => {
      dots.forEach((dot, idx) => {
        if (idx === activeIndex) {
          dot.classList.remove('w-4', 'bg-gold/20');
          dot.classList.add('w-8', 'bg-gold');
        } else {
          dot.classList.remove('w-8', 'bg-gold');
          dot.classList.add('w-4', 'bg-gold/20');
        }
      });
    };

    const scrollToSlide = (index) => {
      const cardWidth = getCardWidth();
      container.scrollTo({
        left: index * cardWidth,
        behavior: getScrollBehavior()
      });
    };

    // Listen to scroll to update dots with throttle
    let scrollTimeout;
    container.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        const cardWidth = getCardWidth();
        if (cardWidth <= 0) return;
        const activeIndex = Math.round(container.scrollLeft / cardWidth);
        if (activeIndex >= 0 && activeIndex < dots.length) {
          updateDots(activeIndex);
        }
      }, 50);
    }, { passive: true });

    // Button clicks
    prevBtn.addEventListener('click', () => {
      const cardWidth = getCardWidth();
      container.scrollBy({
        left: -cardWidth,
        behavior: getScrollBehavior()
      });
    });

    nextBtn.addEventListener('click', () => {
      const cardWidth = getCardWidth();
      container.scrollBy({
        left: cardWidth,
        behavior: getScrollBehavior()
      });
    });

    // Dot clicks
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = parseInt(dot.getAttribute('data-index') || '0', 10);
        scrollToSlide(index);
      });
    });

    // Support drag scrolling for desktop
    let isDown = false;
    let startX;
    let scrollLeft;

    container.addEventListener('mousedown', (e) => {
      isDown = true;
      container.style.cursor = 'grabbing';
      startX = e.pageX - container.offsetLeft;
      scrollLeft = container.scrollLeft;
    });

    container.addEventListener('mouseleave', () => {
      isDown = false;
      container.style.cursor = 'grab';
    });

    container.addEventListener('mouseup', () => {
      isDown = false;
      container.style.cursor = 'grab';
    });

    container.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - container.offsetLeft;
      const walk = (x - startX) * 1.5;
      container.scrollLeft = scrollLeft - walk;
    });
  });
</script>
