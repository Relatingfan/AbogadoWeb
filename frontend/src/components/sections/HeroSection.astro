---
import Button from '../Button.astro';
---

<section id="inicio" class="relative h-screen w-full flex items-center justify-center overflow-hidden">
  
  <div class="absolute inset-0 w-full h-full z-0 bg-bg lg:bg-transparent">
    <div class="absolute inset-0 bg-gradient-to-b from-bg/60 via-transparent to-bg z-10"></div>
  </div>

  
  <div class="relative z-20 max-w-7xl mx-auto px-6 md:px-12 w-full pt-20">
    <div class="max-w-4xl">
      <div class="overflow-hidden mb-4">
        <span class="block font-josefin text-gold text-sm md:text-base tracking-[0.3em] uppercase hero-elem opacity-0">
          Práctica Legal de Excelencia
        </span>
      </div>
      
      <div class="overflow-hidden py-3 -my-3 mb-6">
        <h1 class="font-cormorant text-5xl md:text-7xl lg:text-8xl font-light text-text leading-[1.1] hero-elem opacity-0 px-1">
          Abogados en <span class="font-playfair italic font-normal text-primary">su Ciudad</span>.<br />Defensa Estratégica.
        </h1>
      </div>
      
      <div class="overflow-hidden mb-12 max-w-2xl">
        <p class="font-dmsans text-base md:text-lg text-text/70 font-light leading-relaxed hero-elem opacity-0">
          En nuestra firma legal, redefinimos el estándar del litigio y la consultoría corporativa. Protegemos su patrimonio y reputación con el rigor que el entorno actual exige.
        </p>
      </div>
      
      <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 hero-elem opacity-0 w-full">
        <Button text="Agendar Consulta" href="#contacto" variant="primary" class="w-full sm:w-auto text-center" />
      </div>
    </div>
  </div>

</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (mediaQuery.matches) {
      document.querySelectorAll('.hero-elem').forEach(el => {
        if (el instanceof HTMLElement) {
          el.style.opacity = '1';
          el.style.transform = 'none';
        }
      });
      return;
    }
    
    const tl = gsap.timeline({ delay: 0.2 });
    
    tl.fromTo('.hero-elem', 
      { y: 50, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 1.2,
        stagger: 0.15,
        ease: 'power3.out'
      }
    );

    
  });
</script>
