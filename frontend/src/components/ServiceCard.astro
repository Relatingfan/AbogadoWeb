---
interface Props {
  title: string;
  description: string;
  icon: string;
  delay?: number;
}

const { title, description, icon, delay = 0 } = Astro.props;
---

<div class="service-card group h-full" data-delay={delay}>
  <div class="relative flex flex-col h-full p-8 border border-gold/40 bg-white hover:border-gold transition-colors duration-500">
    
    <div class="relative z-10 flex flex-col h-full">
      <div class="w-14 h-14 border border-gold/40 group-hover:border-gold flex items-center justify-center mb-6 transition-colors duration-500">
        <i class={`ph ${icon} text-2xl text-gold transition-colors duration-500`}></i>
      </div>
      
      <h3 class="font-playfair text-xl font-bold text-gold mb-4 transition-colors duration-300">{title}</h3>
      <div class="w-12 h-px bg-gold mb-4 transition-colors duration-500"></div>
      <p class="font-dmsans text-sm font-light text-black leading-relaxed flex-grow">
        {description}
      </p>
      
    </div>
  </div>
</div>
